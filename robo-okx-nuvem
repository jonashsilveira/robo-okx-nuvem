        return None
    except Exception: return None

def calcular_pivot_supertrend(df, period=10, multiplier=2):
    high_low = df['high'] - df['low']
    high_cp = (df['high'] - df['close'].shift()).abs()
    low_cp = (df['low'] - df['close'].shift()).abs()
    tr = pd.concat([high_low, high_cp, low_cp], axis=1).max(axis=1)
    df['atr'] = tr.rolling(window=period).mean()
    
    df['pivot'] = (df['high'].shift(1) + df['low'].shift(1) + df['close'].shift(1)) / 3
    df['upper'] = df['pivot'] + (multiplier * df['atr'])
    df['lower'] = df['pivot'] - (multiplier * df['atr'])
    
    df['st_direcao'] = 1
    for i in range(1, len(df)):
        if df['close'].iloc[i] > df['upper'].iloc[i-1]: df.loc[df.index[i], 'st_direcao'] = 1
        elif df['close'].iloc[i] < df['lower'].iloc[i-1]: df.loc[df.index[i], 'st_direcao'] = -1
        else:
            df.loc[df.index[i], 'st_direcao'] = df['st_direcao'].iloc[i-1]
            if df['st_direcao'].iloc[i] == 1 and df['lower'].iloc[i] < df['lower'].iloc[i-1]:
                df.loc[df.index[i], 'lower'] = df['lower'].iloc[i-1]
            if df['st_direcao'].iloc[i] == -1 and df['upper'].iloc[i] > df['upper'].iloc[i-1]:
                df.loc[df.index[i], 'upper'] = df['upper'].iloc[i-1]
    return df

def executar_ordem_okx(direcao, simbolo, preco_atual, atr_valor):
    try:
        mercados = okx_corretora.load_markets()
        tamanho_contrato = mercados[simbolo].get('contractSize', 1)
        okx_corretora.set_leverage(ALAVANCAGEM, simbolo, params={'mgnMode': 'isolated'})
        
        valor_posicao = VALOR_POR_ORDEM_USDT * ALAVANCAGEM
        qtd = okx_corretora.amount_to_precision(simbolo, valor_posicao / (preco_atual * tamanho_contrato))
        
        if direcao == 'LONG':
            stop = preco_atual - (atr_valor * 2.5)
            take = preco_atual + (atr_valor * 5.0)
            okx_corretora.create_market_buy_order(simbolo, qtd, params={'tdMode': 'isolated'})
            okx_corretora.create_order(simbolo, 'trigger', 'sell', qtd, params={'tdMode': 'isolated', 'slTriggerPx': okx_corretora.price_to_precision(simbolo, stop), 'slOrdPx': '-1'})
            okx_corretora.create_order(simbolo, 'trigger', 'sell', qtd, params={'tdMode': 'isolated', 'tpTriggerPx': okx_corretora.price_to_precision(simbolo, take), 'tpOrdPx': '-1'})
            avisar_celular(f"🟢 *ORDEM EXECUTADA (LONG): {simbolo}*\n▪ *Entrada:* ${preco_atual:.4f}\n▪ *Alvo:* ${take:.4f}\n▪ *Stop:* ${stop:.4f}")
            
        elif direcao == 'SHORT':
            stop = preco_atual + (atr_valor * 2.5)
            take = preco_atual - (atr_valor * 5.0)
            okx_corretora.create_market_sell_order(simbolo, qtd, params={'tdMode': 'isolated'})
            okx_corretora.create_order(simbolo, 'trigger', 'buy', qtd, params={'tdMode': 'isolated', 'slTriggerPx': okx_corretora.price_to_precision(simbolo, stop), 'slOrdPx': '-1'})
            okx_corretora.create_order(simbolo, 'trigger', 'buy', qtd, params={'tdMode': 'isolated', 'tpTriggerPx': okx_corretora.price_to_precision(simbolo, take), 'tpOrdPx': '-1'})
            avisar_celular(f"🔴 *ORDEM EXECUTADA (SHORT): {simbolo}*\n▪ *Entrada:* ${preco_atual:.4f}\n▪ *Alvo:* ${take:.4f}\n▪ *Stop:* ${stop:.4f}")
            
    except Exception as e:
        avisar_celular(f"❌ *FALHA NA OKX ({simbolo}):* {str(e)}")

def processar_estrategia(simbolo):
    df_macro = buscar_dados(simbolo, TIMEFRAME_MACRO)
    df_sinal = buscar_dados(simbolo, TIMEFRAME_SINAL)
    if df_macro is None or df_sinal is None or len(df_sinal) < 15: return
    
    df_macro = calcular_pivot_supertrend(df_macro, period=SUPERTREND_PERIODO, multiplier=SUPERTREND_MULT)
    df_sinal = calcular_pivot_supertrend(df_sinal, period=SUPERTREND_PERIODO, multiplier=SUPERTREND_MULT)
    
    macro_tendencia = df_macro['st_direcao'].iloc[-1]
    c_atual = df_sinal.iloc[-1]
    c_anterior = df_sinal.iloc[-2]
    
    ultimos_4 = df_sinal.iloc[-5:-1]
    teve_rompimento_long = (ultimos_4['st_direcao'].iloc[0] == -1) and (c_anterior['st_direcao'] == 1)
    teve_rompimento_short = (ultimos_4['st_direcao'].iloc[0] == 1) and (c_anterior['st_direcao'] == -1)
    
    pullback_long = teve_rompimento_long and (c_anterior['close'] < c_anterior['open'])
    pullback_short = teve_rompimento_short and (c_anterior['close'] > c_anterior['open'])
    
    gatilho_long = pullback_long and (c_atual['close'] > c_anterior['high']) and (macro_tendencia == 1)
    gatilho_short = pullback_short and (c_atual['close'] < c_anterior['low']) and (macro_tendencia == -1)

    if gatilho_long:
        executar_ordem_okx('LONG', simbolo, c_atual['close'], c_atual['atr'])
    elif gatilho_short:
        executar_ordem_okx('SHORT', simbolo, c_atual['close'], c_atual['atr'])

def loop_trading():
    avisar_celular("☁️ Robô OKX iniciado na Nuvem Render! Vigiando 73 moedas 24h.")
